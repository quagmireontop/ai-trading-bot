# Copy this file to .env and fill in your own values. Never commit .env.

# Alpaca paper-trading keys (https://app.alpaca.markets -> Paper account -> API Keys).
# Leave blank to run in demo mode with a simulated $100k portfolio.
# (ALPACA_API_KEY / ALPACA_SECRET_KEY and APCA_API_KEY_ID / APCA_API_SECRET_KEY names also work)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Website port
PORT=3000

# --- Needed when the site is on the internet ---
# Website login password. Pick a long one.
DASHBOARD_PASSWORD=
# Long random string. Claude on claude.ai/phone connects at https://your-site/mcp/<MCP_SECRET>
MCP_SECRET=
# Long random string used to sign login cookies (optional; defaults to one derived from the password)
SESSION_SECRET=
# Optional: lets scripts / Claude Code call the API and /mcp with "Authorization: Bearer <token>"
DASHBOARD_TOKEN=

# Autonomous bot (places PAPER orders on its own from news + momentum signals)
AUTO_TRADE=false
BOT_INTERVAL_MINUTES=15
MAX_POSITION_USD=2000
MAX_ORDERS_PER_DAY=10
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,SPY,QQQ

# Optional extra news sources (comma separated RSS URLs added to the built-in list)
EXTRA_RSS_FEEDS=

# Optional phone alerts via ntfy (https://ntfy.sh). Usually you just turn them on from the
# website's Phone alerts card; set NTFY_TOPIC only to choose your own topic name.
NTFY_TOPIC=
